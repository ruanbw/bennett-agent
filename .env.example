# 默认环境变量配置（基础配置）
#
# APP_ENV 可以写在这里，也可以由 shell 导出（shell 优先）。它决定额外加载哪个
# .env.{APP_ENV} 文件；未设置时按 development 处理。
# 解析规则见 app/config/settings.py:resolve_app_env
APP_ENV=development
LITELLM_API_BASE=http://localhost:4000
LITELLM_API_KEY=sk-test-key
MODEL_NAME=openai/gpt-4o
TAVILY_API_KEY=tvly-your-api-key

# 前端来源白名单（逗号分隔）。前端独立跑在 :5173，跨域调用本 API 需要它；
# 换前端端口或从别的机器访问时在这里补齐。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
