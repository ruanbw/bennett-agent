# 默认环境变量配置（基础配置）
#
# APP_ENV 可以写在这里，也可以由 shell 导出（shell 优先）。它决定额外加载哪个
# .env.{APP_ENV} 文件；未设置时按 development 处理。
# 解析规则见 app/config/settings.py:resolve_app_env
APP_ENV=development
LITELLM_API_BASE=http://localhost:4000
LITELLM_API_KEY=sk-test-key
MODEL_NAME=openai/gpt-4o
# 上游模型条目里用作展示描述的字段名；缺失时回退为 "provider name"
MODEL_DESCRIPTION_FIELD=magpie_label
# 展示给用户的助手名称（出现在提示词与 API 标题里）
ASSISTANT_NAME=Bennett
# 上游调用的**空闲**超时（秒）：多久没收到数据就放弃，不是总时长，
# 因此不会提前掉长长的流式输出。默认 120，0 = 不限制。
MODEL_UPSTREAM_TIMEOUT=120
TAVILY_API_KEY=tvly-your-api-key

# 前端来源白名单（逗号分隔）。
#
# 开发期前端走 Vite 代理，与后端同源，因此这个白名单**通常用不上**。它只在
# 「浏览器直连后端」时才生效：例如 frontend/.env 里填了完整的后端地址，
# 或从另一台机器访问。换前端端口或域名时在这里补齐。
#
# 注意：跨域 + cookie 需要 allow_credentials=True，而 allow_origins 不能是 *
# （浏览器会直接拒绝该组合，见 app/server.py）。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 跨域请求是否允许浏览器携带凭据（cookie）。默认 false。
# 设为 true 时 CORS_ALLOWED_ORIGINS 不能含 *（浏览器会直接拒绝该组合），
# 且跨站 cookie 需要 SameSite=None + Secure，即必须同时开 HTTPS 与 AUTH_COOKIE_SECURE。
CORS_ALLOW_CREDENTIALS=false

# 认证与数据库
#
# 会话走 HttpOnly cookie + 服务端会话表（不用 JWT），用户与会话都存在 SQLite 里。
DATABASE_URL=sqlite+aiosqlite:///./bennett.db

# 重置密码/邮箱验证令牌的签名密钥。
# 生成：python -c 'import secrets; print(secrets.token_urlsafe(48))'
# APP_ENV=production 时若仍是下面这个占位值，应用会拒绝启动。
AUTH_SECRET=dev-insecure-secret-change-me

# 会话 cookie 名（默认 bennett_session）。
# 改名等于让所有已登录用户掉线；多实例部署时必须保持一致。
AUTH_COOKIE_NAME=bennett_session

# cookie 是否只走 HTTPS。
# **本地 http 调试必须为 false**，否则浏览器不回传 cookie，表现为「登录了又像没登录」。
AUTH_COOKIE_SECURE=false

# 登录态有效期（秒），默认 30 天
SESSION_LIFETIME_SECONDS=2592000

# 对话限流：单个**账号**每分钟可发起的请求数，0 = 不限流
CHAT_RATE_LIMIT_PER_MINUTE=30

# 认证限流：单个**来源 IP** 每分钟可发起的登录/注册数，0 = 不限流
# 挡的是密码暴力破解与批量注册
AUTH_RATE_LIMIT_PER_MINUTE=10

# 受信任反向代理的 IP 标头（逗号分隔，如 X-Forwarded-For,X-Real-IP）。
# 默认空：直接使用直连 client.host，防止客户端伪造标头绕过限流。
# 仅当部署在受信反向代理之后时按顺序配置。
TRUSTED_PROXY_HEADERS=

# 是否暴露 /docs、/redoc、/openapi.json。
# 默认（不设置）= 自动：APP_ENV=production 时关闭，其余环境开启。
# 需要覆盖自动判断时再取消注释并明确写 true / false。
# ENABLE_API_DOCS=true
