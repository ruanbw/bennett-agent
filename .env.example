# 默认环境变量配置（基础配置）
#
# APP_ENV 可以写在这里，也可以由 shell 导出（shell 优先）。它决定额外加载哪个
# .env.{APP_ENV} 文件；未设置时按 development 处理。
# 解析规则见 app/config/settings.py:resolve_app_env
APP_ENV=development
# 以下三项在首次启动时用于**引导**模型提供商；之后请在管理后台维护（数据库是权威）。
LITELLM_API_BASE=http://localhost:4000
LITELLM_API_KEY=sk-test-key
MODEL_NAME=openai/gpt-4o
# 备用模型（可选，留空 = 不启用）。
# 主模型返回 5xx / 429 / 超时 / 连接失败时，自动切换到备用模型再试一次；
# 401、403、400、404 不切换（同一套凭据/请求本身的问题，换模型也救不回来）。
# 注意：备用模型必须接受与主模型相同的调用参数（reasoning_effort、超时），
# 且流式回答只在“还没输出任何内容”时切换，不会重复输出。
# FALLBACK_MODEL_NAME=openai/gpt-4o-mini
# 上游模型条目里用作展示描述的字段名；缺失时回退为 "provider name"
MODEL_DESCRIPTION_FIELD=magpie_label
# 展示给用户的助手名称（出现在提示词与 API 标题里）
ASSISTANT_NAME=Bennett
# 上游调用的**空闲**超时（秒）：多久没收到数据就放弃，不是总时长，
# 因此不会提前掉长长的流式输出。默认 120，0 = 不限制。
MODEL_UPSTREAM_TIMEOUT=120

# 提供商出站目标是否必须是公网地址（环回/私有/保留段一律拒绝）。
#
# 默认 false：本机 LiteLLM 网关（上面的 LITELLM_API_BASE 默认就是 http://localhost:4000）
# 与内网自建 vLLM 都需要它，开了会把它们拦掉。
# 无论开关如何，链路本地/未指定/组播地址（含云厂商元数据服务 169.254.169.254）永远被拒绝。
# 服务对外暴露时建议设为 true。
# PROVIDER_BLOCK_PRIVATE_TARGETS=false

# 上下文窗口预算。历史是客户端全量回放上来的，字符数上限（后端 400k 字符）挡不住
# token 溢出——40 万中文字符已经是 30 万 token 以上，超过多数模型的窗口。每轮生成
# 前按网关的 context_window 粗估用量（历史 + 系统提示词 + 工具 schema），再按下面的
# 模式处置。不引入分词器依赖，估算偏高于真实值（安全方向）。
#
#   compact = 先压缩，压完仍超才拒绝（默认）
#   reject  = 直接拒绝本轮，并告诉用户超了多少、该做什么
#   off     = 不判定，一律放行
# 网关没报 context_window 的模型一律放行（拿不到数据就不猜）。
#
# compact 的两级策略（app/services/context_compaction.py）：
#   1. 截断超长单条的中间部分（纯计算，不调模型）——保留首尾，绝不碰本轮问题；
#   2. 把更早的轮次折叠成一份「事实清单」注入本轮 instructions（会调一次模型）。
# 压缩是**改了模型看到的上下文**，所以每次压缩都会下发 `compaction` 事件，
# 前端显示成一行提示（含省下多少），导出的 Markdown 里也有。静默压缩比拒绝更糟：
# 用户会把「模型忘了刚才说的」当成模型变笨。
CONTEXT_GUARD_MODE=compact
# 预留 token（留给模型写回复）。网关报了 max_output_tokens 就用它，没报才用这个值；
# 两种取值都会被压在窗口的一半以内。
CONTEXT_RESERVE_TOKENS=8192
# 安全系数：可用上限 =（窗口 - 预留 - 固定开销）× 本值。token 数是估算，留一成余量。
CONTEXT_SAFETY_RATIO=0.9
# 压缩时保留最近多少**轮**问答原文（一轮 = user + assistant 两条），更早的折叠成摘要。
# 调大 = 细节保留更多、能压出的空间更少；调小 = 省更多窗口、但更容易忘掉刚才的事。
CONTEXT_COMPACT_KEEP_RECENT_TURNS=4
# 压缩第一级（截断超长单条）的单条字符上限，保留首尾、中间打省略标记。
# 只作用于本轮问题之外的旧消息——截断最后一条等于替用户改问题。
CONTEXT_COMPACT_MESSAGE_MAX_CHARS=4000

# Tavily 联网搜索。留空或仍是示例占位值（像下面这样含 your-api-key）时视为未配置：
# 搜索工具不会被装配，空对话页也不会推荐搜索类起步示例。
TAVILY_API_KEY=tvly-your-api-key

# MCP（Model Context Protocol）外部工具来源。分号分隔，每条 '名称=传输:目标'。
# 名称只能用字母/数字/下划线/短横线（它会变成工具名前缀，如 `filesystem__read_file`），
# 且必须唯一。两种传输：
#
#   filesystem=url:https://mcp.example.com/mcp
#   local=stdio:/usr/local/bin/my-mcp-server --port 8080
#
# 工具是**动态发现**的：进程启动时连一次，server 报什么工具就挂什么，代码不用改。
# 写错的声明会让启动失败而不是被静默跳过——声明出来的能力不能悄悄消失。
# 只支持 http/https 与本地可执行文件：file:// 之类能读本地文件，不该由「加个 server」开启。
# MCP_SERVERS=
#
# 单个 MCP 工具调用的超时（秒）。MCP server 可能做很重的事（跑查询、读大文件），
# 所以比搜索宽；但必须有上限，否则一个卡死的 server 会一直占着一个 SSE。
MCP_TOOL_TIMEOUT_SECONDS=30

# 进程内指标（/api/metrics，Prometheus 文本格式）。**默认关闭**：它不需要登录就能
# 访问，多开一个端点就多一分侦察面，而多数部署并没有采集器。启用后建议把它挡在内网
# 或反代白名单后面（同 /docs）。
METRICS_ENABLED=false

# 前端来源白名单（逗号分隔）。
#
# 开发期前端走 Vite 代理，与后端同源，因此这个白名单**通常用不上**。它只在
# 「浏览器直连后端」时才生效：例如 frontend/.env 里填了完整的后端地址，
# 或从另一台机器访问。换前端端口或域名时在这里补齐。
#
# 注意：跨域 + cookie 需要 allow_credentials=True，而 allow_origins 不能是 *
# （浏览器会直接拒绝该组合，见 app/server.py）。
#
# 留空 = development 自动允许 http://localhost:5173 与 http://127.0.0.1:5173；
# production 留空**不**回退——前后端分离时这是必须显式配置的一项（同源反代除外）。
# 浏览器 Origin 从不带尾斜杠，这里配了也会被规范化掉。
CORS_ALLOWED_ORIGINS=

# 跨域请求是否允许浏览器携带凭据（cookie）。默认 false。
# 设为 true 时 CORS_ALLOWED_ORIGINS 不能含 *（浏览器会直接拒绝该组合），
# 且跨站 cookie 需要 SameSite=None + Secure，即必须同时开 HTTPS 与 AUTH_COOKIE_SECURE
# （SameSite 会自动切成 none，见下面的 AUTH_COOKIE_SAMESITE）。
CORS_ALLOW_CREDENTIALS=false

# 认证与数据库
#
# 会话走 HttpOnly cookie + 服务端会话表（不用 JWT），用户与会话都存在 Postgres 里。
#
# SQLite 已从支持矩阵移除：并发写入、外键语义与迁移工具链都不足以支撑多实例部署。
# 本地依赖服务全部由 docker-compose 提供（`docker compose up -d`）：postgres / redis / rustfs。
# 注意密码里有特殊字符时必须 URL 编码，否则连接串会被解析成另一个库名。
DATABASE_URL=postgresql+asyncpg://bennett:bennett@127.0.0.1:5432/bennett

# 连接池。**总连接数 = (POOL_SIZE + MAX_OVERFLOW) × worker 数**，
# 必须明显小于 Postgres 的 max_connections，否则一扩容就是全站 500。
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=10
# 必须短于 Postgres / pgbouncer / 云负载均衡的空闲断连时间
DATABASE_POOL_RECYCLE=1800
# 服务端语句超时（毫秒，0 = 不限制）。应用层超时只能放弃等待，不会取消数据库里仍在跑的查询。
DATABASE_STATEMENT_TIMEOUT_MS=30000
# 启动时执行 sql/init.sql 建表（整段幂等，重复执行无副作用）。
# 关掉它适合「结构由别的流程管」的部署；开发与默认生产都保持打开。
DATABASE_APPLY_SCHEMA=true

# Redis：限流计数 / 业务缓存 / 会话热缓存。
#
# Redis 不是可用性单点，每处使用都有降级路径（限流退回进程内计数、缓存 miss、
# 会话回源数据库），但这些降级会在日志与 /health/ready 里体现。
REDIS_URL=redis://127.0.0.1:6379/0
# 多套部署共用一个 Redis 实例时必须各不相同
REDIS_KEY_PREFIX=bennett
REDIS_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=1
# 会话 token 解析的 Redis 加速（数据库仍是权威来源，删会话时两边都删）
REDIS_SESSION_CACHE_ENABLED=true
# 搜索缓存：redis = 多 worker 共享；memory = 进程内 LRU
SEARCH_CACHE_BACKEND=redis
# 就绪探针里必须可用的依赖（database/redis/storage 任选，逗号分隔）。
# 默认只有数据库：Redis 挂了只会降级，不该把实例摘出负载均衡。
READINESS_REQUIRED_DEPENDENCIES=database

# 对象存储（S3 协议；本地用 RustFS，生产可换 AWS S3 / 阿里云 OSS 的 S3 兼容端点）。
#
# 只服务于**沙箱产物**：机器销毁前把它的 workspace 打包导出到这里（见
# app/services/sandbox/artifacts.py）。没开沙箱（SANDBOX_ENABLED=false）时整段可留空。
#
# RustFS 控制台默认在 9001（S3 API 在 9000），首次登录用它建桶/看对象。
# 下面的 access/secret key **必须与 rustfs 容器的一致**，否则导出会在运行期报 403。
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=bennett-artifacts
S3_PREFIX=sandbox
# RustFS / MinIO / 多数自建网关只支持 path-style；AWS 官方 S3 建议关掉
S3_USE_PATH_STYLE=true
# 启动时确保桶存在（幂等）。生产建议关掉，由 IaC 建桶并只授予最小权限。
S3_CREATE_BUCKET=true
# 下载沙箱产物的预签名 URL 有效期（秒）
S3_PRESIGN_EXPIRY_SECONDS=300
S3_CONNECT_TIMEOUT=3
S3_READ_TIMEOUT=60

# 单个 HTTP 请求体的硬上限。
MAX_REQUEST_BODY_BYTES=33554432

# 重置密码/邮箱验证令牌的签名密钥，同时用于加密数据库里的提供商 API Key。
# 生成：python -c 'import secrets; print(secrets.token_urlsafe(48))'
# APP_ENV=production 时若仍是下面这个占位值，应用会拒绝启动。
# 注意：更换 AUTH_SECRET 后，已加密的 API Key 无法解密，需要在管理后台重新填写；
# 升级前写入的明文行仍可读取，并在下次保存时自动加密。
AUTH_SECRET=dev-insecure-secret-change-me

# 会话 cookie 名（默认 bennett_session）。
# 改名等于让所有已登录用户掉线；多实例部署时必须保持一致。
AUTH_COOKIE_NAME=bennett_session

# cookie 是否只走 HTTPS。
# **本地 http 调试必须为 false**，否则浏览器不回传 cookie，表现为「登录了又像没登录」。
AUTH_COOKIE_SECURE=false

# 会话 cookie 的 SameSite：lax / strict / none。留空（默认）= 自动：
# CORS_ALLOW_CREDENTIALS=true 时取 none，否则取 lax。
# 跨站部署（前端在另一个站点）必须用 none，否则浏览器不会在跨站 fetch 里回传 cookie，
# 表现为「登录接口 204、下一个请求 401」。取值 none 时必须同时 AUTH_COOKIE_SECURE=true，
# 否则启动直接报错——浏览器会丢弃这种 cookie。
# AUTH_COOKIE_SAMESITE=lax

# 登录态有效期（秒），默认 30 天
SESSION_LIFETIME_SECONDS=2592000

# 首次启动（model_provider 表为空且从未初始化过）时，是否用上面的
# LITELLM_API_BASE / LITELLM_API_KEY / MODEL_NAME 引导出一条「默认网关」提供商。
#
# 引导只是让升级不中断：之后提供商、模型与启用开关都由管理后台维护，数据库是权威。
# 管理后台里删光提供商会得到「没有任何可用模型」，**不会**回退到环境变量配置。
BOOTSTRAP_PROVIDER_FROM_ENV=true

# 限流计数存储：redis = 跨进程/多实例共享配额（生产默认）；memory = 进程内。
# Redis 不可用时自动降级为进程内计数并告警——降级期间配额会乘以实例数。
RATE_LIMIT_BACKEND=redis

# 对话限流：单个**账号**每分钟可发起的请求数，0 = 不限流
CHAT_RATE_LIMIT_PER_MINUTE=30

# 认证限流：单个**来源 IP** 每分钟可发起的登录/注册数，0 = 不限流
# 挡的是密码暴力破解与批量注册
AUTH_RATE_LIMIT_PER_MINUTE=10

# 受信任反向代理的 IP 标头（逗号分隔，如 X-Forwarded-For,X-Real-IP）。
# 默认空：直接使用直连 client.host，防止客户端伪造标头绕过限流。
#
# **必须同时配置 TRUSTED_PROXY_IPS**：只配标头名而不校验来源，等于让任何直连
# 客户端自己填 X-Forwarded-For 来换限流桶（每次换一个值就绕过 10 次/分钟）。
# 两者都配置后，只有直连对端落在 TRUSTED_PROXY_IPS 内才采信标头，并从右往左
# 跳过受信代理、取第一个非代理地址。仅当部署在受信反向代理之后时按顺序配置。
TRUSTED_PROXY_HEADERS=
# 受信反向代理的 IP/CIDR（逗号分隔，如 10.0.0.0/8,127.0.0.1/32）。
TRUSTED_PROXY_IPS=

# 是否暴露 /docs、/redoc、/openapi.json。
# 默认（不设置）= 自动：APP_ENV=production 时关闭，其余环境开启。
# 需要覆盖自动判断时再取消注释并明确写 true / false。
# ENABLE_API_DOCS=true

# 日志
#
# LOG_LEVEL 只接受 CRITICAL / ERROR / WARNING / INFO / DEBUG（大小写不敏感），
# 配错退回 INFO。DEBUG 下第三方库（httpx / openai 等）仍被压在 WARNING：
# 它们会把请求头打进日志，里面就是 Authorization 与 API Key。
LOG_LEVEL=INFO

# 是否输出 uvicorn 的访问日志。默认关闭：SSE 长连接与前端轮询会让它变成噪音，
# 真正要看的 WARNING 会被淹没。排查接口问题时再打开。
# LOG_ACCESS=true

# 隔离执行环境（沙箱）
#
# 每个用户一台机器、跨会话共用；首次需要执行时自动创建，心跳断了自动销毁。
# 默认全关：没有 sandbox 服务的部署不该凭空多出四个工具。
#
# 后端只有一个：OpenSandbox（本地 Docker 运行时 / 生产 K8s+Firecracker 运行时，同一套 API）。
# 本地怎么起服务见 README「启用沙箱」一节。
SANDBOX_ENABLED=false
SANDBOX_PROVIDER=opensandbox
# sandbox server 地址。本地默认 8080；生产指向集群内 ingress，且必须配 api_key。
SANDBOX_SERVER_URL=http://127.0.0.1:8080
# SANDBOX_SERVER_API_KEY=
SANDBOX_TEMPLATE=bennett-sandbox
SANDBOX_TEMPLATE_VERSION=0.1
SANDBOX_CPU=2
SANDBOX_MEMORY_MB=4096
SANDBOX_WORKDIR=/home/sandbox/workspace
#
# 生命周期：空闲回收看 max(心跳, 最近活动)；绝对上限到了不论有没有心跳都销毁。
SANDBOX_IDLE_SECONDS=600
SANDBOX_HARD_TTL_SECONDS=14400
SANDBOX_HEARTBEAT_SECONDS=30
#
# 容量保护（不是付费分级）：单用户同时活着的机器数（默认 1 = 跨会话共用）、全局并发。
# 超限返回 429 并提示稍后再试，不静默排队。
SANDBOX_MAX_PER_USER=1
SANDBOX_MAX_CONCURRENT=12
#
# 出站：proxy=白名单代理（生产默认，落到 sandbox server 的 egress 策略）；
# open=自由联网，只给本地/自用，启动会打警告。
SANDBOX_EGRESS=proxy
SANDBOX_ARTIFACT_MAX_BYTES=209715200
#
# ---------------------------------------------------------------------------
# 评测 / 调优 / 安全管控（python -m quality，见 docs/design/quality-platform.md）
# ---------------------------------------------------------------------------
# 被测目标的模型：任何 OpenAI 兼容端点都行。默认指向本机 LiteLLM 代理。
# QUALITY_BASE_URL=http://127.0.0.1:3425/v1
# QUALITY_API_KEY=magpie
# QUALITY_MODEL=group/deepseek-v4.1-flash
# QUALITY_TIMEOUT_S=300
#
# 真实实例目标（python -m quality run --target live）：需要已登录会话的 Cookie。
# QUALITY_LIVE_BASE_URL=http://127.0.0.1:8000
# QUALITY_LIVE_COOKIE=bennett_session=...
#
# 审计行的执行人/租户（默认 local / default）。
# QUALITY_ACTOR=ci
# QUALITY_TENANT=platform
