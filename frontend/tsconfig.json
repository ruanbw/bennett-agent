{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // src/ 现在全部是 .ts/.tsx，因此没有需要「允许但不检查」的 JS。
    // allowJs 关掉：如果将来有人往 src/ 里放 .js，tsc 会直接报错而不是静默跳过它——
    // 这正是 C-2 之前踩的坑（没有 tsconfig，所有类型标注都是装饰性的）。
    "allowJs": false,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
